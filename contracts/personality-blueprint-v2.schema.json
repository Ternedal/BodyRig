    "format": {
      "const": "bodyrig-personality-blueprint"
    },
    "version": {
      "const": 2
    },
    "default_language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directness",
        "warmth",
        "playfulness",
        "formality",
        "verbosity",
        "initiative"
      ],
      "properties": {
        "directness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warmth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
