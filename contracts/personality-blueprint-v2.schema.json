{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/personality-blueprint-v2.schema.json",
  "title": "BodyRig Personality Blueprint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "default_language",
    "communication",
    "embodiment",
    "grounding",
    "style_exemplars",
    "authored_notes",
    "inner_ring",
    "outer_ring"
