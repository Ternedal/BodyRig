        "embodiment": {
          "enum": [
            "operator-authored",
            "bodyprint-observed",
            "mixed"
          ]
        },
        "body_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^body-r[0-9]{4}$"
        }
      }
