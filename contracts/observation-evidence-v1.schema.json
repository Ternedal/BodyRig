{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/observation-evidence-v1.schema.json",
  "title": "BodyRig Observation Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "source_manifest_sha256", "selection_sha256", "segments_manifest_sha256", "adapter", "revision", "segments"],
  "properties": {
    "format": {"const": "bodyrig-observation-evidence"},
    "version": {"const": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segments_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 160},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "scene_id", "start_seconds", "duration_seconds", "sha256"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "scene_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "start_seconds": {"type": "number", "minimum": 0, "maximum": 172800},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 12},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
