{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-appearance-epoch-plan-v1.schema.json",
  "title": "BodyRig Photoreal Appearance Epoch Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "performer_id",
    "performer_name",
    "strategy",
    "source_frame_index_model_set_sha256",
    "identity_bank_sha256",
    "identity_calibration_sha256",
    "eligible_observation_count",
    "eligible_train_observation_count",
    "eligible_evaluation_observation_count",
    "source_group_count",
    "evidence_sha256",
    "candidate_epochs",
    "selected_epoch_id",
    "human_epoch_review_required",
    "human_epoch_review_complete",
    "teacher_input_authorized",
    "teacher_training_authorized",
    "photoreal_acceptance_authority",
    "build_only",
    "runtime_dependency",
    "production_activation",
    "appearance_epoch_plan_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-appearance-epoch-plan"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "performer_name": {"type": "string", "maxLength": 4096},
    "strategy": {"const": "human-review-required-v1"},
    "source_frame_index_model_set_sha256": {"$ref": "#/$defs/sha256"},
    "identity_bank_sha256": {"$ref": "#/$defs/sha256"},
    "identity_calibration_sha256": {"$ref": "#/$defs/sha256"},
    "eligible_observation_count": {"type": "integer", "minimum": 2},
    "eligible_train_observation_count": {"type": "integer", "minimum": 1},
    "eligible_evaluation_observation_count": {"type": "integer", "minimum": 1},
    "source_group_count": {"type": "integer", "minimum": 2},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_epochs": {"type": "array", "maxItems": 128},
    "selected_epoch_id": {"type": "null"},
    "human_epoch_review_required": {"const": true},
    "human_epoch_review_complete": {"const": false},
    "teacher_input_authorized": {"const": false},
    "teacher_training_authorized": {"const": false},
    "photoreal_acceptance_authority": {"const": false},
    "build_only": {"const": true},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false},
    "appearance_epoch_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
