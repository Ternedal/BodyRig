{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-teacher-review-render-set-v1.schema.json",
  "title": "BodyRig Photoreal Teacher Review Render Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "performer_id",
    "selected_epoch_id",
    "teacher_input_sha256",
    "teacher_manifest_sha256",
    "adapter",
    "upstream_repository",
    "upstream_commit",
    "camera_calibration_source",
    "camera_calibration_formula",
    "render_count",
    "renders",
    "render_bytes_verified",
    "camera_geometry_authority",
    "semantic_view_authority",
    "human_semantic_view_mapping_required",
    "held_out_reference_binding_present",
    "photoreal_acceptance_authority",
    "human_visual_acceptance_required",
    "build_only",
    "runtime_dependency",
    "production_activation",
    "review_render_set_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-teacher-review-render-set"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "selected_epoch_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "teacher_input_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "adapter": {"const": "exavatar-benchmark"},
    "upstream_repository": {"const": "https://github.com/mks0601/ExAvatar_RELEASE"},
    "upstream_commit": {"const": "d45268730c779fae4118f1a361cf9ff639bc4d1e"},
    "camera_calibration_source": {"const": "avatar/main/get_neutral_pose.py"},
    "camera_calibration_formula": {"const": "azim=pi+2*pi*i/50;elev=-pi/6;view_num=50"},
    "render_count": {"const": 50},
    "renders": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/render"}
    },
    "render_bytes_verified": {"const": true},
    "camera_geometry_authority": {"const": true},
    "semantic_view_authority": {"const": false},
    "human_semantic_view_mapping_required": {"const": true},
    "held_out_reference_binding_present": {"const": false},
    "photoreal_acceptance_authority": {"const": false},
    "human_visual_acceptance_required": {"const": true},
    "build_only": {"const": true},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false},
    "review_render_set_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256",
        "camera",
        "semantic_view_label",
        "semantic_view_authority",
        "human_semantic_view_mapping_required"
      ],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^review/neutral-pose/(?:[0-9]|[1-4][0-9])\\.png$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "camera": {"$ref": "#/$defs/camera"},
        "semantic_view_label": {"type": "null"},
        "semantic_view_authority": {"const": false},
        "human_semantic_view_mapping_required": {"const": true}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orbit_index",
        "azimuth_radians",
        "azimuth_degrees",
        "azimuth_degrees_normalized",
        "elevation_radians",
        "elevation_degrees",
        "render_width",
        "render_height",
        "focal_x_px",
        "focal_y_px",
        "principal_x_px",
        "principal_y_px",
        "look_at_target",
        "up_axis"
      ],
      "properties": {
        "orbit_index": {"type": "integer", "minimum": 0, "maximum": 49},
        "azimuth_radians": {"type": "number"},
        "azimuth_degrees": {"type": "number"},
        "azimuth_degrees_normalized": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "elevation_radians": {"type": "number"},
        "elevation_degrees": {"const": -30.0},
        "render_width": {"const": 1024},
        "render_height": {"const": 1024},
        "focal_x_px": {"const": 1500.0},
        "focal_y_px": {"const": 1500.0},
        "principal_x_px": {"const": 512.0},
        "principal_y_px": {"const": 512.0},
        "look_at_target": {"const": "neutral-smplx-template-mean"},
        "up_axis": {"const": "positive-y"}
      }
    }
  }
}
