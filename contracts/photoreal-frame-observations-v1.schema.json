{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-frame-observations-v1.schema.json",
  "title": "BodyRig Photoreal Frame Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "performer_id",
    "analyzer",
    "analyzer_revision",
    "analyzer_model_set_sha256",
    "identity_embedding_dimension",
    "observations",
    "build_only",
    "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-frame-observations"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "analyzer": {"type": "string", "minLength": 1, "maxLength": 256},
    "analyzer_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "analyzer_model_set_sha256": {"$ref": "#/$defs/sha256"},
    "identity_embedding_dimension": {"type": "integer", "minimum": 32, "maximum": 4096},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": {"$ref": "#/$defs/observation"}
    },
    "build_only": {"const": true},
    "production_activation": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phash64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "unit": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "embedding": {
      "type": "array",
      "minItems": 32,
      "maxItems": 4096,
      "items": {"type": "number"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key",
        "source_sha256",
        "kind",
        "timestamp_seconds",
        "eye",
        "projection",
        "frame_sha256",
        "perceptual_hash",
        "candidate_id",
        "person_detected",
        "width",
        "height",
        "view_bin",
        "face_visibility",
        "full_body_visibility",
        "person_fraction",
        "sharpness",
        "motion",
        "occlusion",
        "identity_measurement_status",
        "identity_embedding"
      ],
      "properties": {
        "source_key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["video", "image"]},
        "timestamp_seconds": {
          "oneOf": [
            {"type": "number", "minimum": 0.0},
            {"type": "null"}
          ]
        },
        "eye": {"enum": ["mono", "left", "right"]},
        "projection": {"type": "string", "minLength": 1, "maxLength": 128},
        "frame_sha256": {"$ref": "#/$defs/sha256"},
        "perceptual_hash": {"$ref": "#/$defs/phash64"},
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "person_detected": {"type": "boolean"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "view_bin": {
          "enum": [
            "front",
            "three-quarter-left",
            "three-quarter-right",
            "profile-left",
            "profile-right",
            "rear",
            "unknown"
          ]
        },
        "face_visibility": {"$ref": "#/$defs/unit"},
        "full_body_visibility": {"$ref": "#/$defs/unit"},
        "person_fraction": {"$ref": "#/$defs/unit"},
        "sharpness": {"$ref": "#/$defs/unit"},
        "motion": {"$ref": "#/$defs/unit"},
        "occlusion": {"$ref": "#/$defs/unit"},
        "identity_measurement_status": {"enum": ["available", "unavailable"]},
        "identity_embedding": {
          "oneOf": [
            {"$ref": "#/$defs/embedding"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "image"}}, "required": ["kind"]},
          "then": {"properties": {"timestamp_seconds": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "video"}}, "required": ["kind"]},
          "then": {"properties": {"timestamp_seconds": {"type": "number", "minimum": 0.0}}}
        },
        {
          "if": {"properties": {"identity_measurement_status": {"const": "available"}}, "required": ["identity_measurement_status"]},
          "then": {
            "properties": {
              "identity_embedding": {"$ref": "#/$defs/embedding"},
              "person_detected": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"identity_measurement_status": {"const": "unavailable"}}, "required": ["identity_measurement_status"]},
          "then": {"properties": {"identity_embedding": {"type": "null"}}}
        },
        {
          "if": {"properties": {"person_detected": {"const": false}}, "required": ["person_detected"]},
          "then": {
            "properties": {
              "identity_measurement_status": {"const": "unavailable"},
              "identity_embedding": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
