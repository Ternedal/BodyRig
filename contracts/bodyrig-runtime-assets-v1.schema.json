{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/bodyrig-runtime-assets-v1.schema.json",
  "title": "BodyRig Materialized Runtime Assets v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "body_id",
    "body_name",
    "package_sha256",
    "avatar",
    "avatar_sha256",
    "bodyprint",
    "bodyprint_sha256",
    "payloads"
  ],
  "properties": {
    "format": {"const": "bodyrig-runtime-assets"},
    "version": {"const": 1},
    "body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9æøå_-]+$"
    },
    "body_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "avatar": {"const": "avatar.vrm"},
    "avatar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bodyprint": {"const": "bodyprint.json"},
    "bodyprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payloads": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "uniqueItems": true,
      "contains": {"const": "avatar.vrm"},
      "items": {
        "type": "string",
        "enum": [
          "avatar.vrm",
          "bodyprint.json",
          "provenance.json",
          "thumbnail.png",
          "motions/idle.vrma",
          "motions/walk.vrma",
          "motions/talk.vrma",
          "motions/gesture_01.vrma",
          "motions/gesture_02.vrma",
          "motions/gesture_03.vrma"
        ]
      }
    }
  }
}
