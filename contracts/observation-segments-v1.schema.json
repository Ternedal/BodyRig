{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/observation-segments-v1.schema.json",
  "title": "BodyRig Observation Segments v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "selection_sha256", "segments"],
  "properties": {
    "format": {"const": "bodyrig-observation-segments"},
    "version": {"const": 1},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "scene_id", "path", "start_seconds", "duration_seconds", "sha256"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "scene_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "start_seconds": {"type": "number", "minimum": 0, "maximum": 172800},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 12},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
