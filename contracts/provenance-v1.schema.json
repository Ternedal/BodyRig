{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/provenance-v1.schema.json",
  "title": "BodyRig provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "created_at", "source", "synthetic_avatar", "pipeline"],
  "properties": {
    "format": {"const": "modelrig-body-provenance"},
    "version": {"const": 1},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {
      "kind": {"const": "user-supplied-local-media"}, "count": {"type": "integer", "minimum": 1, "maximum": 10}
    }},
    "synthetic_avatar": {"const": true},
    "pipeline": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "adapter", "revision"], "properties": {
      "stage": {"type": "string", "minLength": 1, "maxLength": 80},
      "adapter": {"type": "string", "minLength": 1, "maxLength": 120},
      "revision": {"type": "string", "minLength": 1, "maxLength": 160}
    }}}
  }
}
