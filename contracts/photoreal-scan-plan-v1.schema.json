{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-scan-plan-v1.schema.json",
  "title": "BodyRig Photoreal Scan Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "performer_id", "performer_name", "strategy",
    "target_video_interval_seconds", "minimum_video_scout_samples",
    "maximum_video_scout_samples", "source_count", "planned_observation_count",
    "identity_bootstrap_policy", "identity_bootstrap_source_count", "identity_bootstrap_group_count",
    "sources", "all_sources_sha256_bound", "train_evaluation_assignment_inherited",
    "frame_analyzer_required", "teacher_training_authorized", "build_only",
    "runtime_dependency", "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-scan-plan"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "performer_name": {"type": "string"},
    "strategy": {"const": "uniform-midpoint-scout-v1"},
    "target_video_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
    "minimum_video_scout_samples": {"type": "integer", "minimum": 1},
    "maximum_video_scout_samples": {"type": "integer", "minimum": 1},
    "source_count": {"type": "integer", "minimum": 1},
    "planned_observation_count": {"type": "integer", "minimum": 1, "maximum": 120000},
    "identity_bootstrap_policy": {"const": "train-only-single-performer-direct-binding-v1"},
    "identity_bootstrap_source_count": {"type": "integer", "minimum": 0},
    "identity_bootstrap_group_count": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "all_sources_sha256_bound": {"const": true},
    "train_evaluation_assignment_inherited": {"const": true},
    "frame_analyzer_required": {"const": true},
    "teacher_training_authorized": {"const": false},
    "build_only": {"const": true},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crc32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yaw", "pitch", "roll"],
      "properties": {
        "yaw": {"type": "number", "minimum": -180.0, "maximum": 180.0},
        "pitch": {"type": "number", "minimum": -90.0, "maximum": 90.0},
        "roll": {"type": "number", "minimum": -180.0, "maximum": 180.0}
      }
    },
    "equirectangular_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "bottom", "left", "right"],
      "properties": {
        "top": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "bottom": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "left": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "right": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "projection_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "version", "projection_type", "pose_degrees",
        "equirectangular_bounds_fraction", "cubemap_layout", "cubemap_padding_pixels",
        "mesh_projection_crc32", "mesh_projection_encoding", "mesh_projection_payload_bytes",
        "mesh_projection_geometry_sha256", "mesh_projection_mesh_count",
        "mesh_projection_total_vertex_count", "mesh_projection_total_index_count",
        "mesh_projection_texture_ids", "mesh_projection_index_types",
        "mesh_projection_unknown_box_types", "deprojection_authority"
      ],
      "properties": {
        "format": {
          "enum": [
            "bodyrig-spherical-v2-projection-authority",
            "bodyrig-explicit-projection-authority"
          ]
        },
        "version": {"const": 1},
        "projection_type": {"enum": ["equi", "mshp", "cbmp"]},
        "pose_degrees": {"$ref": "#/$defs/pose"},
        "equirectangular_bounds_fraction": {
          "oneOf": [
            {"$ref": "#/$defs/equirectangular_bounds"},
            {"type": "null"}
          ]
        },
        "cubemap_layout": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "cubemap_padding_pixels": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "mesh_projection_crc32": {
          "oneOf": [
            {"$ref": "#/$defs/crc32"},
            {"type": "null"}
          ]
        },
        "mesh_projection_encoding": {
          "oneOf": [
            {"enum": ["raw ", "dfl8"]},
            {"type": "null"}
          ]
        },
        "mesh_projection_payload_bytes": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "mesh_projection_geometry_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "mesh_projection_mesh_count": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 2},
            {"type": "null"}
          ]
        },
        "mesh_projection_total_vertex_count": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "mesh_projection_total_index_count": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "mesh_projection_texture_ids": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
            {"type": "null"}
          ]
        },
        "mesh_projection_index_types": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"enum": [0, 1, 2]}},
            {"type": "null"}
          ]
        },
        "mesh_projection_unknown_box_types": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 4, "maxLength": 4}},
            {"type": "null"}
          ]
        },
        "deprojection_authority": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {"const": "bodyrig-explicit-projection-authority"}
            },
            "required": ["format"]
          },
          "then": {
            "properties": {
              "projection_type": {"const": "equi"},
              "equirectangular_bounds_fraction": {"$ref": "#/$defs/equirectangular_bounds"},
              "cubemap_layout": {"type": "null"},
              "cubemap_padding_pixels": {"type": "null"},
              "mesh_projection_crc32": {"type": "null"},
              "mesh_projection_encoding": {"type": "null"},
              "mesh_projection_payload_bytes": {"type": "null"},
              "mesh_projection_geometry_sha256": {"type": "null"},
              "mesh_projection_mesh_count": {"type": "null"},
              "mesh_projection_total_vertex_count": {"type": "null"},
              "mesh_projection_total_index_count": {"type": "null"},
              "mesh_projection_texture_ids": {"type": "null"},
              "mesh_projection_index_types": {"type": "null"},
              "mesh_projection_unknown_box_types": {"type": "null"}
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_seconds", "eye"],
      "properties": {
        "timestamp_seconds": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "null"}
          ]
        },
        "eye": {"enum": ["mono", "left", "right"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key", "source_sha256", "resolved_path", "kind", "split",
        "group_id", "source_binding", "performer_count", "projection",
        "projection_authority", "stereo_layout", "decode_mode",
        "identity_bootstrap_eligible", "sample_count", "samples"
      ],
      "properties": {
        "source_key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_path": {"type": "string", "minLength": 1, "maxLength": 32768},
        "kind": {"enum": ["video", "image"]},
        "split": {"enum": ["train", "evaluation"]},
        "group_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_binding": {"type": "string", "minLength": 1, "maxLength": 128},
        "performer_count": {"type": "integer", "minimum": 0},
        "projection": {
          "enum": ["flat", "vr180", "vr360", "equirectangular", "equi", "mshp", "cbmp"]
        },
        "projection_authority": {
          "oneOf": [
            {"$ref": "#/$defs/projection_authority"},
            {"type": "null"}
          ]
        },
        "stereo_layout": {"enum": ["mono", "side-by-side", "over-under", "mesh-custom"]},
        "decode_mode": {
          "enum": [
            "image-direct",
            "rectilinear-mono",
            "rectilinear-stereo-split",
            "spatial-deprojection-required"
          ]
        },
        "identity_bootstrap_eligible": {"type": "boolean"},
        "sample_count": {"type": "integer", "minimum": 1},
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sample"}
        }
      }
    }
  }
}
