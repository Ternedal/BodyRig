{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/observation-selection-v1.schema.json",
  "title": "BodyRig Observation Selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "source_manifest_sha256", "adapter", "revision", "selected"],
  "properties": {
    "format": {"const": "bodyrig-observation-selection"},
    "version": {"const": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 160},
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "scene_id", "start_seconds", "duration_seconds",
          "target_confidence", "target_screen_fraction", "face_visibility",
          "full_body_visibility", "sharpness", "occlusion", "motion", "view", "base_score"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "scene_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "start_seconds": {"type": "number", "minimum": 0, "maximum": 172800},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 12},
          "target_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "target_screen_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "face_visibility": {"type": "number", "minimum": 0, "maximum": 1},
          "full_body_visibility": {"type": "number", "minimum": 0, "maximum": 1},
          "sharpness": {"type": "number", "minimum": 0, "maximum": 1},
          "occlusion": {"type": "number", "minimum": 0, "maximum": 1},
          "motion": {"type": "number", "minimum": 0, "maximum": 1},
          "view": {"enum": ["front", "left_profile", "right_profile", "rear", "unknown"]},
          "base_score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
