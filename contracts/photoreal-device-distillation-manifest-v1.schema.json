{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bodyrig-photoreal-device-distillation-manifest-v1",
  "title": "BodyRig Photoreal device distillation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "performer_id", "selected_epoch_id", "teacher_input_sha256",
    "teacher_manifest_sha256", "static_teacher_review_sha256", "animation_plan_sha256",
    "animation_execution_receipt_sha256", "animated_teacher_review_sha256",
    "device_distillation_plan_sha256", "target_profile_sha256", "adapter", "adapter_revision",
    "student_representation", "distillation_complete", "consumed_distillation_source_artifacts",
    "fidelity_delta_measurements", "student_artifacts", "student_fidelity_claim_exceeds_teacher",
    "human_runtime_visual_acceptance_required", "runtime_acceptance_authority", "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-device-distillation-manifest"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1},
    "selected_epoch_id": {"type": "string", "minLength": 1},
    "teacher_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "teacher_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "static_teacher_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animation_execution_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animated_teacher_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device_distillation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"type": "string", "minLength": 1},
    "adapter_revision": {"type": "string", "minLength": 1},
    "student_representation": {"type": "string", "minLength": 1},
    "distillation_complete": {"const": true},
    "consumed_distillation_source_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "fidelity_delta_measurements": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "metric", "value", "unit", "teacher_reference", "student_reference"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "teacher_reference": {"type": "string", "minLength": 1},
          "student_reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "student_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "relative_path", "size_bytes", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "student_fidelity_claim_exceeds_teacher": {"const": false},
    "human_runtime_visual_acceptance_required": {"const": true},
    "runtime_acceptance_authority": {"const": false},
    "production_activation": {"const": false}
  }
}
