{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/observation-analyzer-config-v1.schema.json",
  "title": "BodyRig Observation Analyzer Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "adapter", "revision", "command", "timeout_seconds"],
  "properties": {
    "format": {"const": "bodyrig-observation-analyzer-config"},
    "version": {"const": 1},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 160},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
  }
}
