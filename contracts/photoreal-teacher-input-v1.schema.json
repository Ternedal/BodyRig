{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-teacher-input-v1.schema.json",
  "title": "BodyRig Photoreal Teacher Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "performer_id",
    "performer_name",
    "selected_epoch_id",
    "appearance_epoch_selection_sha256",
    "identity_bank_sha256",
    "identity_calibration_sha256",
    "analyzer_model_set_sha256",
    "training_sources",
    "held_out_evaluation_sources",
    "training_observations",
    "held_out_evaluation_observations",
    "held_out_view_coverage_required",
    "held_out_view_coverage_observed",
    "held_out_view_coverage_missing",
    "training_source_count",
    "held_out_evaluation_source_count",
    "training_observation_count",
    "held_out_evaluation_observation_count",
    "evaluation_bytes_excluded_from_teacher_request",
    "teacher_training_authorized",
    "photoreal_acceptance_authority",
    "human_visual_acceptance_required",
    "build_only",
    "runtime_dependency",
    "production_activation",
    "teacher_input_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-teacher-input"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "performer_name": {"type": "string", "maxLength": 4096},
    "selected_epoch_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "appearance_epoch_selection_sha256": {"$ref": "#/$defs/sha256"},
    "identity_bank_sha256": {"$ref": "#/$defs/sha256"},
    "identity_calibration_sha256": {"$ref": "#/$defs/sha256"},
    "analyzer_model_set_sha256": {"$ref": "#/$defs/sha256"},
    "training_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "held_out_evaluation_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "training_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "held_out_evaluation_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "held_out_view_coverage_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "held_out_view_coverage_observed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "held_out_view_coverage_missing": {"const": []},
    "training_source_count": {"type": "integer", "minimum": 1},
    "held_out_evaluation_source_count": {"type": "integer", "minimum": 1},
    "training_observation_count": {"type": "integer", "minimum": 1},
    "held_out_evaluation_observation_count": {"type": "integer", "minimum": 1},
    "evaluation_bytes_excluded_from_teacher_request": {"const": true},
    "teacher_training_authorized": {"const": true},
    "photoreal_acceptance_authority": {"const": false},
    "human_visual_acceptance_required": {"const": true},
    "build_only": {"const": true},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false},
    "teacher_input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "group_id", "kind", "resolved_path", "size_bytes", "sha256", "information_score", "width", "height", "projection", "stereo_layout"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "group_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "kind": {"enum": ["video", "image"]},
        "resolved_path": {"type": "string", "minLength": 1, "maxLength": 32768},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "information_score": {"type": "number", "minimum": 0},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "projection": {"type": "string", "minLength": 1, "maxLength": 128},
        "stereo_layout": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "group_id", "split", "frame_sha256", "timestamp_seconds", "eye", "view_bin", "coverage"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "group_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "split": {"enum": ["train", "evaluation"]},
        "frame_sha256": {"$ref": "#/$defs/sha256"},
        "timestamp_seconds": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "eye": {"enum": ["mono", "left", "right"]},
        "view_bin": {"type": "string", "minLength": 1, "maxLength": 64},
        "coverage": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    }
  }
}
