{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BodyRig Photoreal P0 crash receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "bodyrig_revision",
    "performer_id",
    "failed_stage_number",
    "failed_stage_label",
    "failure_class",
    "child_exit_code",
    "error_message",
    "artifact_presence",
    "artifact_present_count",
    "artifact_expected_count",
    "output_root_build_private",
    "partial_outputs_may_not_grant_authority",
    "restart_same_output_root_supported",
    "recovery_action",
    "teacher_training_authorized",
    "photoreal_acceptance_authority",
    "production_activation",
    "p0_crash_receipt_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-p0-crash-receipt"},
    "version": {"type": "number", "const": 1},
    "bodyrig_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "failed_stage_number": {"type": "integer", "minimum": 0, "maximum": 16},
    "failed_stage_label": {"type": "string", "minLength": 1, "maxLength": 256},
    "failure_class": {"const": "unexpected-exception"},
    "child_exit_code": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "not": {"enum": [0, 2]}
    },
    "error_message": {"type": "string", "minLength": 1, "maxLength": 4000},
    "artifact_presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source-inventory.json",
        "dataset-plan.json",
        "source-receipt.json",
        "scan-plan.json",
        "identity-bootstrap-plan.json",
        "model-set.json",
        "identity-extractor/output/identity-observations.json",
        "identity-bank.json",
        "identity-negative-inventory.json",
        "identity-negative-receipt.json",
        "identity-calibration-plan.json",
        "identity-calibration-extractor/output/negative-observations.json",
        "identity-calibration.json",
        "frame-measurements.json",
        "frame-authorized-observations.json",
        "frame-index.json"
      ],
      "properties": {
        "source-inventory.json": {"type": "boolean"},
        "dataset-plan.json": {"type": "boolean"},
        "source-receipt.json": {"type": "boolean"},
        "scan-plan.json": {"type": "boolean"},
        "identity-bootstrap-plan.json": {"type": "boolean"},
        "model-set.json": {"type": "boolean"},
        "identity-extractor/output/identity-observations.json": {"type": "boolean"},
        "identity-bank.json": {"type": "boolean"},
        "identity-negative-inventory.json": {"type": "boolean"},
        "identity-negative-receipt.json": {"type": "boolean"},
        "identity-calibration-plan.json": {"type": "boolean"},
        "identity-calibration-extractor/output/negative-observations.json": {"type": "boolean"},
        "identity-calibration.json": {"type": "boolean"},
        "frame-measurements.json": {"type": "boolean"},
        "frame-authorized-observations.json": {"type": "boolean"},
        "frame-index.json": {"type": "boolean"}
      }
    },
    "artifact_present_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "artifact_expected_count": {"const": 16},
    "output_root_build_private": {"const": true},
    "partial_outputs_may_not_grant_authority": {"const": true},
    "restart_same_output_root_supported": {"const": false},
    "recovery_action": {"const": "fix-root-cause-and-run-again-with-a-new-empty-output-root"},
    "teacher_training_authorized": {"const": false},
    "photoreal_acceptance_authority": {"const": false},
    "production_activation": {"const": false},
    "p0_crash_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
