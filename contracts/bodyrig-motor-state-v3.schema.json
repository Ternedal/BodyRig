{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/bodyrig-motor-state-v3.schema.json",
  "title": "BodyRig Motor State v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "body_id", "utterance_id", "motion"],
  "properties": {
    "type": {"const": "bodyrig-motor-state"},
    "version": {"const": 3},
    "body_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9æøå_-]+$"},
    "utterance_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy", "head_motion"],
      "properties": {
        "energy": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "head_motion": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emotion", "intensity"],
      "properties": {
        "emotion": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_-]+$"},
        "intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "amplitude"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9_-]+$"},
        "amplitude": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "gaze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "strength"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 127, "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"},
        "strength": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "posture": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "intensity"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9_-]+$"},
            "intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source", "intensity", "torso_forward_lean_degrees", "torso_right_lean_degrees", "shoulder_roll_degrees", "hip_roll_degrees", "head_forward_offset_to_height", "head_right_offset_to_height"],
          "properties": {
            "id": {"const": "natural"},
            "source": {"const": "modelrig-bodyprint-v1"},
            "intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "torso_forward_lean_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "torso_right_lean_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "shoulder_roll_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "hip_roll_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "head_forward_offset_to_height": {"type": "number", "minimum": -1.0, "maximum": 1.0},
            "head_right_offset_to_height": {"type": "number", "minimum": -1.0, "maximum": 1.0}
          }
        }
      ]
    },
    "locomotion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "effort", "transition_intensity", "cadence_spm", "stride_length_to_height", "stance_width_to_height", "vertical_bounce_to_height", "left_arm_swing_to_height", "right_arm_swing_to_height", "arm_swing_to_height"],
          "properties": {
            "action": {"const": "walk"},
            "effort": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "transition_intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "cadence_spm": {"type": "number", "minimum": 30.0, "maximum": 240.0},
            "stride_length_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "stance_width_to_height": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "vertical_bounce_to_height": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "left_arm_swing_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "right_arm_swing_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "arm_swing_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "effort", "transition_intensity", "turn_speed_degrees_per_second"],
          "properties": {
            "action": {"enum": ["turn_left", "turn_right"]},
            "effort": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "transition_intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "turn_speed_degrees_per_second": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 720.0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "effort", "transition_intensity"],
          "properties": {
            "action": {"const": "stop"},
            "effort": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "transition_intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        }
      ]
    },
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "elapsed_ms"],
      "properties": {
        "state": {"enum": ["start", "update", "stop"]},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
        "viseme": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._-]+$"},
        "amplitude": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "embodiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed"],
      "properties": {
        "source": {"const": "modelrig-bodyprint-v1"},
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "energy": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "gesture_frequency": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "gesture_amplitude": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "head_motion": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "turn_speed": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "walk_cadence_spm": {"type": "number", "minimum": 0.0, "maximum": 300.0},
            "posture_torso_lean_degrees": {"type": "number", "minimum": 0.0, "maximum": 90.0},
            "posture_torso_forward_lean_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "posture_torso_right_lean_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "posture_shoulder_tilt_degrees": {"type": "number", "minimum": 0.0, "maximum": 90.0},
            "posture_shoulder_roll_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "posture_hip_tilt_degrees": {"type": "number", "minimum": 0.0, "maximum": 90.0},
            "posture_hip_roll_degrees": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "posture_head_offset_to_height": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "posture_head_forward_offset_to_height": {"type": "number", "minimum": -1.0, "maximum": 1.0},
            "posture_head_right_offset_to_height": {"type": "number", "minimum": -1.0, "maximum": 1.0},
            "stride_length_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "stance_width_to_height": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "vertical_bounce_to_height": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "left_arm_swing_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "right_arm_swing_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "arm_swing_to_height": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "arm_swing_asymmetry": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "turn_speed_degrees_per_second": {"type": "number", "minimum": 0.0, "maximum": 720.0},
            "transition_intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "idle_sway_to_height": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "blink_rate_per_min": {"type": "number", "minimum": 0.0, "maximum": 120.0},
            "gaze_strength": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "head_tilt": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "speech_motion": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "idle_strength": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "gaze_smoothing": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "gesture_intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "breathing_strength": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        }
      }
    }
  }
}
