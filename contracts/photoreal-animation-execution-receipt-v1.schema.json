{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-animation-execution-receipt-v1.schema.json",
  "title": "BodyRig Photoreal animation execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "performer_id",
    "selected_epoch_id",
    "teacher_input_sha256",
    "teacher_manifest_sha256",
    "static_teacher_review_sha256",
    "animation_plan_sha256",
    "adapter",
    "adapter_revision",
    "representation",
    "animation_complete",
    "consumed_teacher_artifacts",
    "implemented_validation_dimensions",
    "animation_artifacts",
    "artifact_bytes_verified_by_core",
    "animated_teacher_acceptance_authority",
    "human_animated_visual_acceptance_required",
    "p3_device_distillation_authorized",
    "production_activation",
    "animation_execution_receipt_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-animation-execution-receipt"},
    "version": {"type": "number", "const": 1},
    "performer_id": {"type": "string", "minLength": 1},
    "selected_epoch_id": {"type": "string", "minLength": 1},
    "teacher_input_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "static_teacher_review_sha256": {"$ref": "#/$defs/sha256"},
    "animation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "adapter": {"type": "string", "minLength": 1},
    "adapter_revision": {"type": "string", "minLength": 1},
    "representation": {"type": "string", "minLength": 1},
    "animation_complete": {"const": true},
    "consumed_teacher_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/consumed"}
    },
    "implemented_validation_dimensions": {"$ref": "#/$defs/dimensions"},
    "animation_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "artifact_bytes_verified_by_core": {"const": true},
    "animated_teacher_acceptance_authority": {"const": false},
    "human_animated_visual_acceptance_required": {"const": true},
    "p3_device_distillation_authorized": {"const": false},
    "production_activation": {"const": false},
    "animation_execution_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consumed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "size_bytes", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dimensions": {
      "type": "array",
      "prefixItems": [
        {"const": "body_pose_smplx_correspondence"},
        {"const": "face_expression_control"},
        {"const": "head_turn_validation"},
        {"const": "eye_motion_validation"},
        {"const": "mouth_motion_validation"},
        {"const": "hand_motion_validation"},
        {"const": "full_body_pose_validation"},
        {"const": "identity_appearance_motion_preservation"}
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    }
  }
}
