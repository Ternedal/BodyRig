{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bodyrig-photoreal-device-runtime-review-plan-v1",
  "title": "BodyRig Photoreal device runtime review plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "performer_id", "selected_epoch_id", "teacher_input_sha256",
    "teacher_manifest_sha256", "static_teacher_review_sha256", "animation_plan_sha256",
    "animation_execution_receipt_sha256", "animated_teacher_review_sha256",
    "device_distillation_plan_sha256", "device_distillation_execution_receipt_sha256",
    "target_profile", "target_profile_sha256", "student_representation", "student_artifact_count",
    "student_artifacts", "student_artifact_bytes_reverified", "fidelity_delta_measurements",
    "teacher_remains_visual_authority", "student_fidelity_claim_exceeds_teacher",
    "physical_device_evidence_required", "physical_device_evidence_present",
    "human_runtime_visual_acceptance_required", "runtime_review_ready",
    "runtime_acceptance_authority", "production_activation", "device_runtime_review_plan_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-device-runtime-review-plan"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1},
    "selected_epoch_id": {"type": "string", "minLength": 1},
    "teacher_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "teacher_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "static_teacher_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animation_execution_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animated_teacher_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device_distillation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device_distillation_execution_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_profile": {"type": "object"},
    "target_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "student_representation": {"type": "string", "minLength": 1},
    "student_artifact_count": {"type": "integer", "minimum": 1},
    "student_artifacts": {"type": "array", "minItems": 1},
    "student_artifact_bytes_reverified": {"const": true},
    "fidelity_delta_measurements": {"type": "array", "minItems": 8, "maxItems": 8},
    "teacher_remains_visual_authority": {"const": true},
    "student_fidelity_claim_exceeds_teacher": {"const": false},
    "physical_device_evidence_required": {"const": true},
    "physical_device_evidence_present": {"const": false},
    "human_runtime_visual_acceptance_required": {"const": true},
    "runtime_review_ready": {"const": true},
    "runtime_acceptance_authority": {"const": false},
    "production_activation": {"const": false},
    "device_runtime_review_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
