{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-identity-negative-receipt-v1.schema.json",
  "title": "BodyRig Photoreal Identity Negative Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "target_performer_id", "label_authority", "negative_performer_count",
    "source_count", "total_bytes", "sources", "all_sources_readable", "all_sources_sha256_bound",
    "calibration_only", "photoreal_teacher_input", "teacher_training_authorized",
    "identity_matching_authorized", "build_only", "runtime_dependency", "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-identity-negative-receipt"},
    "version": {"const": 1},
    "target_performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "label_authority": {"const": "stash-single-performer-other-id-v1"},
    "negative_performer_count": {"type": "integer", "minimum": 1},
    "source_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "all_sources_readable": {"const": true},
    "all_sources_sha256_bound": {"const": true},
    "calibration_only": {"const": true},
    "photoreal_teacher_input": {"const": false},
    "teacher_training_authorized": {"const": false},
    "identity_matching_authorized": {"const": false},
    "build_only": {"const": true},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false},
    "path_map_mode": {"type": "string"},
    "stash_origin": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key", "subject_performer_id", "subject_performer_name", "target_performer_id",
        "target_performer_absent", "label_authority", "kind", "source_binding", "catalog_path",
        "resolved_path", "size_bytes", "sha256", "width", "height"
      ],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "subject_performer_id": {"type": "string", "minLength": 1},
        "subject_performer_name": {"type": "string"},
        "target_performer_id": {"type": "string", "minLength": 1},
        "target_performer_absent": {"const": true},
        "label_authority": {"const": "stash-single-performer-other-id-v1"},
        "kind": {"enum": ["video", "image"]},
        "source_binding": {"enum": ["scene-single-performer", "direct-performer"]},
        "catalog_path": {"type": "string", "minLength": 1},
        "resolved_path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "projection": {"type": "string"},
        "stereo_layout": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "frame_rate": {"type": "number", "minimum": 0},
        "megapixels": {"type": "number", "minimum": 0}
      }
    }
  }
}
