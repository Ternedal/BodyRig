{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/bodyrig-release-acceptance-v1.schema.json",
  "title": "BodyRig Release Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "completed_at",
    "bodyrig_revision",
    "automated_acceptance",
    "renderer_acceptance",
    "release_gate_pass",
    "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-release-acceptance"},
    "version": {"const": 1},
    "completed_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "bodyrig_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "automated_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "package_sha256", "body_id", "automated_pass"],
      "properties": {
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "body_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9æøå_-]+$"
        },
        "automated_pass": {"const": true}
      }
    },
    "renderer_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_unity_univrm",
        "android_quest_class",
        "quality_note",
        "attestation",
        "attested_at"
      ],
      "properties": {
        "windows_unity_univrm": {"const": "pass"},
        "android_quest_class": {"const": "pass"},
        "quality_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": ".*\\S.*"
        },
        "attestation": {"const": "operator-supplied"},
        "attested_at": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "release_gate_pass": {"const": true},
    "production_activation": {"const": true}
  }
}
