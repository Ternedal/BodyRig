{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-identity-negative-observations-v1.schema.json",
  "title": "BodyRig Photoreal Identity Negative Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "target_performer_id", "identity_bank_sha256", "extractor",
    "extractor_revision", "model_set_sha256", "embedding_dimension", "observations",
    "calibration_only", "build_only", "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-identity-negative-observations"},
    "version": {"const": 1},
    "target_performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "identity_bank_sha256": {"$ref": "#/$defs/sha256"},
    "extractor": {"type": "string", "minLength": 1, "maxLength": 256},
    "extractor_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "model_set_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_dimension": {"type": "integer", "minimum": 32, "maximum": 4096},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "calibration_only": {"const": true},
    "build_only": {"const": true},
    "production_activation": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key", "source_sha256", "subject_performer_id", "timestamp_seconds", "eye",
        "frame_sha256", "embedding"
      ],
      "properties": {
        "source_key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "subject_performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "timestamp_seconds": {"oneOf": [{"type": "number", "minimum": 0.0}, {"type": "null"}]},
        "eye": {"enum": ["mono", "left", "right"]},
        "frame_sha256": {"$ref": "#/$defs/sha256"},
        "embedding": {
          "type": "array",
          "minItems": 32,
          "maxItems": 4096,
          "items": {"type": "number"}
        }
      }
    }
  }
}
