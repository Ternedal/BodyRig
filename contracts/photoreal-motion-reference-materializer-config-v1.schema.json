{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-motion-reference-materializer-config-v1.schema.json",
  "title": "BodyRig Photoreal motion reference materializer config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "adapter", "revision", "command", "timeout_seconds"],
  "properties": {
    "format": {"const": "bodyrig-photoreal-motion-reference-materializer-config"},
    "version": {"type": "number", "const": 1},
    "adapter": {"const": "bodyrig-motion-reference-materializer-v1"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
  }
}
