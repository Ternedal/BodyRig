{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-static-teacher-human-review-v1.schema.json",
  "title": "BodyRig Photoreal Static Teacher Human Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "performer_id", "selected_epoch_id", "teacher_input_sha256",
    "review_render_set_sha256", "review_mapping_sha256", "held_out_reference_catalog_sha256",
    "materialization_receipt_sha256", "reviewer", "reviewed_utc", "operator_supplied",
    "comparison_count", "comparisons", "checklist", "quality_note", "human_review_complete",
    "human_review_outcome", "human_review_pass", "static_teacher_photoreal_accepted",
    "photoreal_acceptance_authority", "p2_animation_work_authorized", "runtime_dependency",
    "production_activation", "static_teacher_review_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-static-teacher-human-review"},
    "version": {"const": 1},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "selected_epoch_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "teacher_input_sha256": {"$ref": "#/$defs/sha256"},
    "review_render_set_sha256": {"$ref": "#/$defs/sha256"},
    "review_mapping_sha256": {"$ref": "#/$defs/sha256"},
    "held_out_reference_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "materialization_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 256},
    "reviewed_utc": {"type": "string", "minLength": 1},
    "operator_supplied": {"const": true},
    "comparison_count": {"type": "integer", "minimum": 1},
    "comparisons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/comparison"}},
    "checklist": {"$ref": "#/$defs/checklist"},
    "quality_note": {"type": "string", "minLength": 1, "maxLength": 4000},
    "human_review_complete": {"const": true},
    "human_review_outcome": {"enum": ["pass", "fail"]},
    "human_review_pass": {"type": "boolean"},
    "static_teacher_photoreal_accepted": {"type": "boolean"},
    "photoreal_acceptance_authority": {"type": "boolean"},
    "p2_animation_work_authorized": {"type": "boolean"},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false},
    "static_teacher_review_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["pass", "fail"]},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage", "teacher_render_orbit_index", "teacher_render_relative_path", "teacher_render_sha256",
        "reference_observation_id", "reference_png_relative_path", "reference_png_sha256",
        "reference_frame_sha256", "human_outcome"
      ],
      "properties": {
        "coverage": {"type": "string", "minLength": 1, "maxLength": 64},
        "teacher_render_orbit_index": {"type": "integer", "minimum": 0, "maximum": 49},
        "teacher_render_relative_path": {"type": "string", "minLength": 1},
        "teacher_render_sha256": {"$ref": "#/$defs/sha256"},
        "reference_observation_id": {"$ref": "#/$defs/sha256"},
        "reference_png_relative_path": {"type": "string", "minLength": 1},
        "reference_png_sha256": {"$ref": "#/$defs/sha256"},
        "reference_frame_sha256": {"$ref": "#/$defs/sha256"},
        "human_outcome": {"$ref": "#/$defs/outcome"}
      }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_likeness", "skin_material_not_waxy_or_plastic", "eyes_source_consistent",
        "hair_silhouette_source_consistent", "hands_anatomically_credible",
        "cross_view_geometry_and_identity_stable"
      ],
      "properties": {
        "identity_likeness": {"$ref": "#/$defs/outcome"},
        "skin_material_not_waxy_or_plastic": {"$ref": "#/$defs/outcome"},
        "eyes_source_consistent": {"$ref": "#/$defs/outcome"},
        "hair_silhouette_source_consistent": {"$ref": "#/$defs/outcome"},
        "hands_anatomically_credible": {"$ref": "#/$defs/outcome"},
        "cross_view_geometry_and_identity_stable": {"$ref": "#/$defs/outcome"}
      }
    }
  }
}
