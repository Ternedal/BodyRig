{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/identity-capture-config-v1.schema.json",
  "title": "BodyRig Identity Capture Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "adapter", "revision", "command", "timeout_seconds"],
  "properties": {
    "format": {"const": "bodyrig-identity-capture-config"},
    "version": {"const": 1},
    "adapter": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*"},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
  }
}
