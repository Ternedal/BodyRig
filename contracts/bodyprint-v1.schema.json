{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/bodyprint-v1.schema.json",
  "title": "BodyRig BodyPrint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version"],
  "properties": {
    "format": {"const": "modelrig-bodyprint"},
    "version": {"const": 1},
    "shape": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {
      "height_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
      "shoulder_to_height": {"type": "number", "minimum": 0, "maximum": 1},
      "hip_to_height": {"type": "number", "minimum": 0, "maximum": 1},
      "arm_to_height": {"type": "number", "minimum": 0, "maximum": 1},
      "leg_to_height": {"type": "number", "minimum": 0, "maximum": 1}
    }},
    "motion": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {
      "energy": {"type": "number", "minimum": 0, "maximum": 1},
      "gesture_frequency": {"type": "number", "minimum": 0, "maximum": 1},
      "gesture_amplitude": {"type": "number", "minimum": 0, "maximum": 1},
      "head_motion": {"type": "number", "minimum": 0, "maximum": 1},
      "turn_speed": {"type": "number", "minimum": 0, "maximum": 1},
      "walk_cadence_spm": {"type": "number", "minimum": 0, "maximum": 300},
      "movement_observed_frames": {"type": "integer", "minimum": 2, "maximum": 1000000},
      "movement_observed_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
      "gait_step_events": {"type": "integer", "minimum": 0, "maximum": 1000000},
      "idle_observed_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
      "posture_torso_lean_degrees": {"type": "number", "minimum": 0, "maximum": 90},
      "posture_torso_forward_lean_degrees": {"type": "number", "minimum": -90, "maximum": 90},
      "posture_torso_right_lean_degrees": {"type": "number", "minimum": -90, "maximum": 90},
      "posture_shoulder_tilt_degrees": {"type": "number", "minimum": 0, "maximum": 90},
      "posture_shoulder_roll_degrees": {"type": "number", "minimum": -90, "maximum": 90},
      "posture_hip_tilt_degrees": {"type": "number", "minimum": 0, "maximum": 90},
      "posture_hip_roll_degrees": {"type": "number", "minimum": -90, "maximum": 90},
      "posture_head_offset_to_height": {"type": "number", "minimum": 0, "maximum": 1},
      "posture_head_forward_offset_to_height": {"type": "number", "minimum": -1, "maximum": 1},
      "posture_head_right_offset_to_height": {"type": "number", "minimum": -1, "maximum": 1},
      "stride_length_to_height": {"type": "number", "minimum": 0, "maximum": 2},
      "stance_width_to_height": {"type": "number", "minimum": 0, "maximum": 1},
      "vertical_bounce_to_height": {"type": "number", "minimum": 0, "maximum": 1},
      "left_arm_swing_to_height": {"type": "number", "minimum": 0, "maximum": 2},
      "right_arm_swing_to_height": {"type": "number", "minimum": 0, "maximum": 2},
      "arm_swing_to_height": {"type": "number", "minimum": 0, "maximum": 2},
      "arm_swing_asymmetry": {"type": "number", "minimum": 0, "maximum": 1},
      "turn_speed_degrees_per_second": {"type": "number", "minimum": 0, "maximum": 720},
      "transition_intensity": {"type": "number", "minimum": 0, "maximum": 1},
      "idle_sway_to_height": {"type": "number", "minimum": 0, "maximum": 1}
    }},
    "expression": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {
      "blink_rate_per_min": {"type": "number", "minimum": 0, "maximum": 120},
      "gaze_strength": {"type": "number", "minimum": 0, "maximum": 1},
      "head_tilt": {"type": "number", "minimum": 0, "maximum": 1},
      "speech_motion": {"type": "number", "minimum": 0, "maximum": 1}
    }},
    "runtime": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {
      "idle_strength": {"type": "number", "minimum": 0, "maximum": 1},
      "gaze_smoothing": {"type": "number", "minimum": 0, "maximum": 1},
      "gesture_intensity": {"type": "number", "minimum": 0, "maximum": 1},
      "breathing_strength": {"type": "number", "minimum": 0, "maximum": 1}
    }}
  },
  "anyOf": [{"required": ["shape"]}, {"required": ["motion"]}, {"required": ["expression"]}, {"required": ["runtime"]}]
}
