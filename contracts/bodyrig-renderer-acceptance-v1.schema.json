{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/bodyrig-renderer-acceptance-v1.schema.json",
  "title": "BodyRig Physical Renderer Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "attested_at",
    "bodyrig_revision",
    "automated_report_sha256",
    "probe_report_sha256",
    "deformation_report_sha256",
    "deformation_sequence_revision",
    "package_sha256",
    "runtime_manifest_sha256",
    "avatar_sha256",
    "bodyprint_sha256",
    "body_id",
    "platform",
    "renderer_name",
    "renderer_version",
    "unity_platform",
    "unity_version",
    "graphics_device",
    "machine_probe",
    "deformation_probe",
    "result",
    "quality_review",
    "quality_note",
    "attestation",
    "production_activation"
  ],
  "properties": {
    "format": {"const": "bodyrig-renderer-acceptance"},
    "version": {"const": 1},
    "attested_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "bodyrig_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "automated_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probe_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deformation_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deformation_sequence_revision": {"const": "humanoid-muscle-sweep-v1"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "avatar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bodyprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9æøå_-]+$"
    },
    "platform": {"enum": ["windows-unity-univrm", "android-quest-class"]},
    "renderer_name": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*"},
    "renderer_version": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*"},
    "unity_platform": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": ".*\\S.*"},
    "unity_version": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": ".*\\S.*"},
    "graphics_device": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": ".*\\S.*"},
    "machine_probe": {"const": true},
    "deformation_probe": {"const": true},
    "result": {"const": "pass"},
    "quality_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "full_deformation_sequence_reviewed",
        "source_identity_texture_acceptable",
        "geometry_proportions_acceptable",
        "upper_body_deformation_acceptable",
        "lower_body_deformation_acceptable",
        "cross_limb_leakage_absent",
        "skin_qa_considered"
      ],
      "properties": {
        "revision": {"const": "bodyrig-human-quality-v1"},
        "full_deformation_sequence_reviewed": {"const": true},
        "source_identity_texture_acceptable": {"const": true},
        "geometry_proportions_acceptable": {"const": true},
        "upper_body_deformation_acceptable": {"const": true},
        "lower_body_deformation_acceptable": {"const": true},
        "cross_limb_leakage_absent": {"const": true},
        "skin_qa_considered": {"const": true}
      }
    },
    "quality_note": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*"},
    "attestation": {"const": "operator-supplied"},
    "production_activation": {"const": false}
  }
}
