{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/bodyrig-hair-deformation-probe-v1.schema.json",
  "title": "BodyRig Hair Deformation Probe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format","version","observed_at","bodyrig_revision","platform","unity_platform","unity_version","build_guid","device_model",
    "body_id","package_sha256","runtime_manifest_sha256","avatar_sha256","bodyprint_sha256","sequence_revision",
    "hair_node","hair_mesh","hair_bone_count","vertex_count","skinned_mesh_renderer_found","head_bone_resolved","head_bone_bound",
    "requested_head_turn_degrees","observed_head_turn_degrees","vertex_motion_rms_m","vertex_motion_max_m","restoration_rms_m","restoration_max_m",
    "vertex_motion_observed","restored_neutral","complete","human_review_required","comparison_only","hair_component_authority","production_activation"
  ],
  "properties": {
    "format": {"const":"bodyrig-hair-deformation-probe"},
    "version": {"const":1},
    "observed_at": {"type":"string","minLength":1,"maxLength":80},
    "bodyrig_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "platform": {"enum":["windows-unity-univrm","android-quest-class"]},
    "unity_platform": {"type":"string","minLength":1,"maxLength":80},
    "unity_version": {"type":"string","minLength":1,"maxLength":80},
    "build_guid": {"type":"string","minLength":1,"maxLength":160},
    "device_model": {"type":"string","minLength":1,"maxLength":240},
    "body_id": {"type":"string","minLength":1,"maxLength":160,"pattern":"^[a-z0-9æøå_-]+$"},
    "package_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "runtime_manifest_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "avatar_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "bodyprint_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "sequence_revision": {"const":"source-hair-head-turn-v1"},
    "hair_node": {"const":"BodyRigSourceHairReview"},
    "hair_mesh": {"const":"BodyRigSourceHairReviewMesh"},
    "hair_bone_count": {"type":"integer","minimum":1},
    "vertex_count": {"type":"integer","minimum":3},
    "skinned_mesh_renderer_found": {"const":true},
    "head_bone_resolved": {"const":true},
    "head_bone_bound": {"const":true},
    "requested_head_turn_degrees": {"const":28.0},
    "observed_head_turn_degrees": {"type":"number","minimum":18.2,"maximum":60.0},
    "vertex_motion_rms_m": {"type":"number","minimum":0.00025},
    "vertex_motion_max_m": {"type":"number","minimum":0.001},
    "restoration_rms_m": {"type":"number","minimum":0.0,"maximum":0.00025},
    "restoration_max_m": {"type":"number","minimum":0.0,"maximum":0.001},
    "vertex_motion_observed": {"const":true},
    "restored_neutral": {"const":true},
    "complete": {"const":true},
    "human_review_required": {"const":true},
    "comparison_only": {"const":true},
    "hair_component_authority": {"const":false},
    "production_activation": {"const":false}
  }
}
