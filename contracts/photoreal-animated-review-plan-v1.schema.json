{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/photoreal-animated-review-plan-v1.schema.json",
  "title": "BodyRig Photoreal animated review plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "performer_id",
    "selected_epoch_id",
    "teacher_input_sha256",
    "teacher_manifest_sha256",
    "static_teacher_review_sha256",
    "animation_plan_sha256",
    "animation_execution_receipt_sha256",
    "held_out_reference_catalog_sha256",
    "reviewer",
    "operator_supplied",
    "motion_review_dimensions",
    "selection_count",
    "selections",
    "animation_artifact_bytes_reverified",
    "held_out_evaluation_only",
    "held_out_motion_reference_selection_complete",
    "motion_reference_materialization_required",
    "reference_motion_bytes_materialized",
    "human_animated_visual_acceptance_required",
    "animated_teacher_acceptance_authority",
    "p3_device_distillation_authorized",
    "source_paths_build_private",
    "build_only",
    "runtime_dependency",
    "production_activation",
    "animated_review_plan_sha256"
  ],
  "properties": {
    "format": {"const": "bodyrig-photoreal-animated-review-plan"},
    "version": {"type": "number", "const": 1},
    "performer_id": {"type": "string", "minLength": 1},
    "selected_epoch_id": {"type": "string", "minLength": 1},
    "teacher_input_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "static_teacher_review_sha256": {"$ref": "#/$defs/sha256"},
    "animation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "animation_execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "held_out_reference_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 256},
    "operator_supplied": {"const": true},
    "motion_review_dimensions": {"$ref": "#/$defs/dimensions"},
    "selection_count": {"const": 6},
    "selections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/selection"}
    },
    "animation_artifact_bytes_reverified": {"const": true},
    "held_out_evaluation_only": {"const": true},
    "held_out_motion_reference_selection_complete": {"const": true},
    "motion_reference_materialization_required": {"const": true},
    "reference_motion_bytes_materialized": {"const": false},
    "human_animated_visual_acceptance_required": {"const": true},
    "animated_teacher_acceptance_authority": {"const": false},
    "p3_device_distillation_authorized": {"const": false},
    "source_paths_build_private": {"const": true},
    "build_only": {"const": true},
    "runtime_dependency": {"const": false},
    "production_activation": {"const": false},
    "animated_review_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimensions": {
      "type": "array",
      "prefixItems": [
        {"const": "head_turn_validation"},
        {"const": "eye_motion_validation"},
        {"const": "mouth_motion_validation"},
        {"const": "hand_motion_validation"},
        {"const": "full_body_pose_validation"},
        {"const": "identity_appearance_motion_preservation"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "animation_artifact_kind",
        "animation_artifact_relative_path",
        "animation_artifact_size_bytes",
        "animation_artifact_sha256",
        "reference_observation_id",
        "reference_source_key",
        "reference_source_group_id",
        "reference_source_resolved_path",
        "reference_source_sha256",
        "reference_source_projection",
        "reference_source_stereo_layout",
        "reference_timestamp_seconds",
        "reference_eye",
        "reference_view_bin",
        "reference_frame_sha256",
        "window_before_seconds",
        "window_after_seconds",
        "window_start_seconds",
        "window_end_seconds",
        "reference_motion_bytes_materialized"
      ],
      "properties": {
        "dimension": {"type": "string"},
        "animation_artifact_kind": {"type": "string", "minLength": 1},
        "animation_artifact_relative_path": {"type": "string", "minLength": 1},
        "animation_artifact_size_bytes": {"type": "integer", "minimum": 1},
        "animation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "reference_observation_id": {"$ref": "#/$defs/sha256"},
        "reference_source_key": {"type": "string", "minLength": 1},
        "reference_source_group_id": {"type": "string", "minLength": 1},
        "reference_source_resolved_path": {"type": "string", "minLength": 1},
        "reference_source_sha256": {"$ref": "#/$defs/sha256"},
        "reference_source_projection": {"type": "string", "minLength": 1},
        "reference_source_stereo_layout": {"type": "string", "minLength": 1},
        "reference_timestamp_seconds": {"type": "number", "minimum": 0},
        "reference_eye": {"enum": ["mono", "left", "right"]},
        "reference_view_bin": {"type": "string", "minLength": 1},
        "reference_frame_sha256": {"$ref": "#/$defs/sha256"},
        "window_before_seconds": {"type": "number", "minimum": 0.25, "maximum": 5.0},
        "window_after_seconds": {"type": "number", "minimum": 0.25, "maximum": 5.0},
        "window_start_seconds": {"type": "number", "minimum": 0},
        "window_end_seconds": {"type": "number", "minimum": 0},
        "reference_motion_bytes_materialized": {"const": false}
      }
    }
  }
}
