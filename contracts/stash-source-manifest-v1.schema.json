{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyrig.local/contracts/stash-source-manifest-v1.schema.json",
  "title": "BodyRig Stash Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "source_kind",
    "performer",
    "stash_version",
    "candidate_count",
    "selected"
  ],
  "properties": {
    "format": {"const": "bodyrig-stash-source-manifest"},
    "version": {"const": 1},
    "source_kind": {"const": "stash-local"},
    "performer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "disambiguation"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "disambiguation": {"type": "string", "maxLength": 500}
      }
    },
    "stash_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "scene_title",
          "path",
          "width",
          "height",
          "duration",
          "framerate",
          "performer_count",
          "score"
        ],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "scene_title": {"type": "string", "minLength": 1, "maxLength": 1000},
          "path": {"type": "string", "minLength": 1, "maxLength": 32767},
          "width": {"type": "integer", "minimum": 0, "maximum": 65535},
          "height": {"type": "integer", "minimum": 0, "maximum": 65535},
          "duration": {"type": "number", "minimum": 0},
          "framerate": {"type": "number", "minimum": 0, "maximum": 1000},
          "performer_count": {"type": "integer", "minimum": 1, "maximum": 1000},
          "score": {"type": "number"}
        }
      }
    }
  }
}
